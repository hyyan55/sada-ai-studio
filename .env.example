# Add the real values only in Render > Environment. Never commit API keys.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: comma-separated exact frontend origins. Use * temporarily if the frontend URL is not known.
ALLOWED_ORIGINS=*
# Optional Groq model override (default: whisper-large-v3-turbo)
GROQ_MODEL=whisper-large-v3-turbo
