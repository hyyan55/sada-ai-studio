# Add real values only in Render > Environment. Never commit API keys.
GEMINI_API_KEY=
GROQ_API_KEY=
# Required: exact public Sada frontend origin, e.g. https://your-sada-site.onrender.com
# Add multiple origins comma-separated. Do not include a trailing slash.
ALLOWED_ORIGINS=
# Optional Groq model override (default: whisper-large-v3-turbo)
GROQ_MODEL=whisper-large-v3-turbo
